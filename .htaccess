# Redirect 301 URL website lama (.php) — issue #3
# Anchor #armada/#layanan/#area/#kontak dipakai sitelink Google Ads; jangan diubah tanpa koordinasi.
# Query string (mis. ?gclid= dari auto-tagging Google Ads) dipertahankan & ditaruh SEBELUM #anchor.
# Target ditulis absolut https: origin hanya HTTP (Cloudflare Flexible), jadi redirect relatif
# akan menghasilkan http:// dan menambah satu hop http->https.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # www -> apex
    RewriteCond %{HTTP_HOST} ^www\.rentcarprofessional\.com$ [NC]
    RewriteRule ^ https://rentcarprofessional.com%{REQUEST_URI} [R=301,L,NE]

    # /index.php, /paketNatal.php, /paketLebaran.php -> /  (query string ikut otomatis)
    RewriteRule ^(index|paketNatal|paketLebaran)\.php$ https://rentcarprofessional.com/ [R=301,L,NC]

    # /harga.php, /paketHiace.php -> /#armada
    RewriteCond %{QUERY_STRING} .
    RewriteRule ^(harga|paketHiace)\.php$ https://rentcarprofessional.com/?%{QUERY_STRING}#armada [R=301,L,NE,NC,QSD]
    RewriteRule ^(harga|paketHiace)\.php$ https://rentcarprofessional.com/#armada [R=301,L,NE,NC]
</IfModule>
